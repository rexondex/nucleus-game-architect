{
  "name": "virtual-forest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check:types": "tsc -b --pretty",
    "check:lint": "eslint .",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs -- src",
    "check:content": "node scripts/check-content.mjs",
    "check:game": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test src/02_api-controller/verification/game-check.test.ts",
    "view:game": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/02_api-controller/verification/game-viewer.ts",
    "check": "npm run check:types && npm run check:lint && npm run check:architecture && npm run check:content && npm run check:game"
  },
  "dependencies": {
    "@react-three/fiber": "^9.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^17.3.8",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.0"
  }
}
